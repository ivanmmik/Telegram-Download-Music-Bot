# Telegram (required)
BOT_TOKEN=your_bot_token_from_botfather

# Paths
DATABASE_PATH=./data/library.db
DOWNLOAD_DIR=./downloads

# Download limits
MAX_FILE_MB=50
DOWNLOAD_TIMEOUT_SEC=120
HTTP_HEAD_TIMEOUT_SEC=15

# Comma-separated hostnames allowed for direct downloads (empty = any host, still subject to direct-media rules)
# Example: cdn.example.com,files.myserver.org
ALLOWED_HOSTS=

# Admin web (FastAPI)
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8080
# Set to protect HTML UI (leave empty to disable auth in local dev only)
ADMIN_SECRET=
